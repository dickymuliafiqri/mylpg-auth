# ===== Turso Auth DB (SHARED dengan aplikasi ../mylpg) =====
# WAJIB sama persis dengan ../mylpg/.env agar kedua app mengelola tabel yang sama.
TURSO_DATABASE_URL="libsql://your-db.turso.io"
TURSO_DATABASE_TOKEN="your-turso-token"

# ===== Session cookie dashboard (nuxt-auth-utils) =====
# Minimal 32 karakter. Generate: openssl rand -hex 32
NUXT_SESSION_PASSWORD="change-me-to-a-random-string-min-32-chars"

# ===== Seed admin dashboard pertama =====
# Dipakai sekali saat tabel app_users masih kosong.
APP_USERNAME="admin"
APP_PASSWORD="ganti-password-kuat"

# ===== Public API key (opsional) =====
# Kalau diisi, endpoint /api/public/* milik ../mylpg wajib kirim header
# x-api-key dengan nilai ini. Kosongkan untuk menonaktifkan proteksi key.
PUBLIC_API_KEY=""
